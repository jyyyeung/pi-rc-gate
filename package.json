{
  "name": "pi-rc-gate",
  "version": "0.1.1",
  "description": "Exit-code honesty for coding agents: warns when piped git verbs, || true swallows, or late $? reads would let a failed command be reported as success — plus a static shell lint and a verification-before-claiming skill.",
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions/",
    "src/",
    "skills/",
    "scripts/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "exit-code",
    "shell",
    "git",
    "verification",
    "coding-agent",
    "anti-fabrication"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyyyeung/pi-rc-gate.git"
  },
  "homepage": "https://github.com/jyyyeung/pi-rc-gate#readme",
  "bugs": {
    "url": "https://github.com/jyyyeung/pi-rc-gate/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^24.0.0",
    "jiti": "^2.7.0",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./extensions/rc-gate.ts"
    ],
    "skills": [
      "./skills/rc-gate"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts && bash scripts/rc-gate.sh scripts/rc-gate.sh"
  }
}
