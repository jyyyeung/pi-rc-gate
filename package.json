{
  "name": "pi-rc-gate",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Exit-code honesty for coding agents: warns when piped git verbs, || true swallows, or late $? reads would let a failed command be reported as success — plus a static shell lint and a verification-before-claiming skill.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "exit-code",
    "shell",
    "git",
    "verification",
    "coding-agent",
    "anti-fabrication"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jyyyeung/pi-rc-gate.git"
  },
  "pi": {
    "extensions": ["./extensions/rc-gate.ts"],
    "skills": ["./skills/rc-gate"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts && bash scripts/rc-gate.sh scripts/rc-gate.sh"
  }
}
